import sys
sys.setrecursionlimit(10000)

def tarjan(adj):
    timp = [0]
    disc, low = {}, {}
    stiva = []          # stiva de muchii
    articulatii = set()
    componente = []     # componentele biconexe

    def dfs(u, parinte):
        timp[0] += 1
        disc[u] = low[u] = timp[0]
        copii = 0
        for v in adj[u]:
            if v == parinte:
                continue
            if v not in disc:
                copii += 1
                stiva.append((u, v))
                dfs(v, u)
                low[u] = min(low[u], low[v])
                if low[v] >= disc[u]:
                    if parinte is not None or copii > 1:
                        articulatii.add(u)
                    comp = []
                    while True:
                        e = stiva.pop()
                        comp.append(e)
                        if e == (u, v):
                            break
                    componente.append(comp)
            elif disc[v] < disc[u]:
                stiva.append((u, v))
                low[u] = min(low[u], disc[v])

    for s in adj:
        if s not in disc:
            dfs(s, None)
    return articulatii, componente

def construieste(muchii):
    adj = {}
    for a, b in muchii:
        adj.setdefault(a, []).append(b)
        adj.setdefault(b, []).append(a)
    return adj

def afiseaza(nume, muchii):
    art, comp = tarjan(construieste(muchii))
    print(f"--- {nume} ---")
    print("Puncte de articulatie:", sorted(art) if art else "niciunul")
    print("Componente biconexe:", len(comp))
    for i, c in enumerate(comp, 1):
        varfuri = sorted({x for e in c for x in e})
        print(f"  {i}: varfuri {varfuri}")

